<form id="maptilerTokenForm" method="post">
    <fieldset class="uk-fieldset">
        <legend class="uk-legend">Set your MapTiler <b>API KEY</b></legend>
        <div class="uk-margin">
            <input class="uk-input" type="text" name="maptiler_token_val" placeholder="MapTiler API Key">
        </div>
        <span style="color:red">{{msg}}</span>
        <div class="uk-margin">
            <button class="uk-button uk-button-primary" style="color: white; background: linear-gradient(to right, #004CFF, #006FFF, #0090FF, #00AAFF, #00C0FF);" type="submit">Submit</button>
        </div>
    </fieldset>
</form>
